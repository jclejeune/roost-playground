<%! var count: Int %>
<main>
  <p class="eyebrow">SWIFT + HEEX</p>
  <h1>A template, alive.</h1>
  <p class="lede">Edit Views/counter.live.hesw and save to rebuild this preview.</p>
  <section aria-label="Counter">
    <div class="counter"><output id="count" aria-live="polite">{count}</output><button type="button" esw-click="increment" aria-label="Increase">+</button></div>
  </section>
</main>
